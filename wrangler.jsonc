{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chiptech-website",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/privacy",
      "/privacy/",
      "/",
      "/android-beta",
      "/android-beta/*"
    ]
  },
  "observability": {
    "enabled": false
  },
  "account_id": "d084cd1fddf5223787eaf1011a3e78d2",
  "triggers": {
    "crons": []
  },
  "routes": [
    {
      "pattern": "chiptechllc.com",
      "custom_domain": true,
      "zone_name": "chiptechllc.com"
    },
    {
      "pattern": "www.chiptechllc.com",
      "custom_domain": true,
      "zone_name": "chiptechllc.com"
    }
  ],
  "workers_dev": true,
  "preview_urls": false
}
